# Copy to .env and fill in. .env is gitignored.
# The reasoning backend (required for full runs):
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Optional paid web-search providers. Leave empty to use keyless connectors
# (DuckDuckGo HTML, Wikipedia, arXiv, Hacker News/Algolia, GitHub).
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# SERPER_API_KEY=

# Optional: log each LLM call to this path for debugging/audit.
# VERITAS_LLM_LOG=
