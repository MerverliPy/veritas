# secrets — never commit
.env
*.env
!.env.example

# python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# outputs — `veritas run` artifacts
# default ./out, plus the exact filenames the runner emits (report.md,
# ledger.json) so a custom --outdir is never accidentally committed.
out/
report.md
ledger.json
*.report.md
*.ledger.json
